{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "Finite, Tiled, Seamless World Wrapping",
	"authors": [
		"Famro Fexl",
        "Skidam"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/circumnavigate",
		"sources": "https://github.com/FamroFexl/Circumnavigate",
		"issues": "https://github.com/FamroFexl/Circumnavigate/issues"
	},
	"license": "AGPL-3.0",
	"icon": "assets/circumnavigate/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "com.fexl.circumnavigate.Circumnavigate"
		],
		"client": [
          "com.fexl.circumnavigate.CircumnavigateClient"
		],
        "server": [
          "com.fexl.circumnavigate.CircumnavigateServer"
        ]
	},
    "accessWidener": "circumnavigate.accesswidener",
    "custom": {
      	"loom:injected_interfaces": {
        	"net/minecraft/class_3222": ["com/fexl/circumnavigate/injected/ServerPlayerInjector"],
        	"net/minecraft/class_1937": ["com/fexl/circumnavigate/injected/DimensionTransformerInjector"],
        	"net/minecraft/class_1922": ["com/fexl/circumnavigate/injected/DimensionTransformerInjector", "com/fexl/circumnavigate/injected/IsClientSideInjector"],
        	"net/minecraft/class_1924": ["com/fexl/circumnavigate/injected/DimensionTransformerInjector"],
            "net/minecraft/class_3196": ["com/fexl/circumnavigate/injected/DimensionTransformerInjector"]
        }
    },
	"mixins": [
		"circumnavigate.mixins.json",
		{
			"config": "circumnavigate-client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${mc_version}",
		"java": ">=${java_version}",
		"fabric-api": ">=${fabric_version}"
	}
}